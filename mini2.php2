        linear-gradient(
            90deg,
            rgba(255,230,0,.035),
            rgba(212,175,55,.07),
            rgba(22,119,255,.035)
        );

    font-size:10px;

    letter-spacing:1.2px;

    text-transform:uppercase;
}

td,
th{

    padding:11px 12px;

    text-align:left;

    border-bottom:
        1px solid
        rgba(255,255,255,.055);
}

tr:hover td{

    background:
        linear-gradient(
            90deg,
            rgba(255,230,0,.025),
            rgba(22,119,255,.025),
            rgba(32,232,121,.02)
        );
}

.name{
    font-weight:700;
}

.dir{
    color:var(--yellow);
}

.perm{
    font-family:monospace;
}

.w{
    color:var(--green2);
}

.nw{
    color:var(--red2);
}


/* ACTIONS */

.action-form{

    display:inline-flex;

    align-items:center;

    gap:5px;

    margin:2px;
}

.action-form input{

    width:100px;

    padding:5px 7px;
}

.btn{

    display:inline-block;

    color:var(--blue2);

    padding:6px 10px;

    border:
        1px solid
        rgba(22,119,255,.35);

    border-radius:6px;

    background:
        rgba(22,119,255,.045);

    transition:.2s;
}

.btn:hover{

    color:#fff;

    background:
        var(--blue);

    border-color:
        var(--blue);

    box-shadow:
        0 0 18px
        rgba(22,119,255,.28);
}

.delbtn{

    display:inline-block;

    color:var(--red2);

    padding:6px 10px;

    border:
        1px solid
        rgba(255,48,79,.35);

    border-radius:6px;

    background:
        rgba(255,48,79,.04);
}

.delbtn:hover{

    color:#fff;

    background:
        var(--red);

    border-color:
        var(--red);

    box-shadow:
        0 0 20px
        rgba(255,48,79,.28);
}


/* TERMINAL */

.terminal{
    padding:18px;
}

.cmdbar{

    display:flex;

    gap:8px;

    margin:12px 0;
}

.cmdbar input{
    flex:1;
}

.terminal pre{

    height:70vh;

    margin:0;

    overflow:auto;

    padding:16px;

    color:var(--green2);

    background:#020403;

    border:
        1px solid
        rgba(32,232,121,.30);

    border-radius:9px;

    white-space:pre-wrap;

    font-family:
        Consolas,
        Monaco,
        monospace;

    line-height:1.5;
}


/* EDITOR */

.editor{
    padding:18px;
}

.editor-head{

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:10px;
}

.editor-title{

    color:#fff;

    font-size:16px;

    font-weight:800;
}

textarea{

    width:100%;

    height:70vh;

    margin:12px 0;

    resize:vertical;

    padding:14px;

    color:#e8e0c8;

    font-family:
        Consolas,
        Monaco,
        monospace;

    line-height:1.55;
}


/* ALERT */

.alert{

    padding:12px 15px;

    margin-bottom:14px;

    border-radius:10px;

    font-weight:700;
}

.alert-success{

    color:var(--green2);

    border:
        1px solid
        rgba(32,232,121,.30);

    background:
        rgba(32,232,121,.045);
}

.alert-error{

    color:var(--red2);

    border:
        1px solid
        rgba(255,48,79,.30);

    background:
        rgba(255,48,79,.045);
}


/* FOOTER */

.footer{

    padding:18px 0 4px;

    color:#555e70;

    text-align:center;

    font-size:9px;

    letter-spacing:1.5px;
}


/* MOBILE */

@media(max-width:760px){

    body{
        padding:10px;
    }

    .Hackerone-header{
        padding:15px;
    }

    .Hackerone-badge{
        display:none;
    }

    .path{

        width:100%;

        max-width:100%;

        margin-left:0;
    }

    td,
    th{
        padding:9px 7px;
    }

    .action-form{
        display:flex;
    }

    .cmdbar{
        flex-direction:column;
    }
}

