$ﬕﬓﾚ̧̩̣́ = <<<'CSS'

:root{
    --black:#03050a;
    --black2:#070b13;

    --panel:#0b111d;
    --panel2:#101827;

    --yellow:#ffe600;
    --yellow2:#fff47a;

    --blue:#1677ff;
