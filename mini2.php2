        );

    transition:.2s;
}

button:hover{

    transform:
        translateY(-1px);

    box-shadow:
        0 0 25px
        rgba(255,230,0,.25);
}


/* PANEL */

.panel{

    position:relative;

    background:
        linear-gradient(
            145deg,
            rgba(16,24,39,.96),
            rgba(6,9,16,.96)
        );

    border:
        1px solid
        rgba(212,175,55,.18);

    border-radius:15px;

    box-shadow:
        var(--shadow);

    overflow:hidden;

    backdrop-filter:
        blur(14px);
}

.panel:before{

    content:"";

    position:absolute;

    top:0;
    left:0;
    right:0;

    height:1px;

    background:
        linear-gradient(
            90deg,
            transparent,
            var(--yellow),
            var(--blue),
            var(--gold),
            var(--green),
            var(--red),
            transparent
        );

    opacity:.8;
}


/* HEADER */

.Hackerone-header{

    display:flex;

