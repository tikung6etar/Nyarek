    --gold:#d4af37;
    --gold2:#ffd966;

    --red:#ff304f;
    --red2:#ff7184;

    --green:#20e879;
    --green2:#68ffab;

    --white:#f5f7ff;
    --muted:#7f8ba3;

    --shadow:
        0 18px 55px rgba(0,0,0,.70);
}

*{
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{

    margin:0;
    padding:24px;

    min-height:100vh;

    color:var(--white);

    font-family:
        Inter,
