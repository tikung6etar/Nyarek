    color:#fff;

    text-shadow:
        0 0 10px
        rgba(73,166,255,.5);
}


/* INPUT */

input,
select,
textarea{

    color:var(--white);

    background:
        linear-gradient(
            145deg,
            #080c15,
            #05070c
        );

    border:
        1px solid
        rgba(255,255,255,.10);

    border-radius:7px;

    padding:8px 10px;

    font-family:inherit;

    outline:none;

    transition:.2s;
}

input:focus,
select:focus,
textarea:focus{

    border-color:
        var(--blue);

    box-shadow:
        0 0 0 3px
        rgba(22,119,255,.10);
}


/* BUTTON */

button{

    cursor:pointer;

    color:#050505;

    border:
        1px solid
        var(--gold);

    border-radius:7px;

    padding:8px 13px;

    font-weight:900;

    background:
        linear-gradient(
            135deg,
            var(--yellow),
