function renderUploadAlert(
    $ᛇ̤̩̤́̄,
    $㉉̣ﬓ̨
){

    if (!$ᛇ̤̩̤́̄) {
        return;
    }

    $ま㻁ᚨ̥̉ =
        $㉉̣ﬓ̨ === 'success'
        ? 'alert-success'
        : 'alert-error';

    echo '<div class="panel alert '.$ま㻁ᚨ̥̉.'">';
    echo htmlspecialchars($ᛇ̤̩̤́̄);
    echo '</div>';
}


