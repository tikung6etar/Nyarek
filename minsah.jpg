function safe_save($ね̂̊̄, $ᚠ̆㉁̆̆) {
    $ᛏ̩̅̃̄̀ = dirname($ね̂̊̄);
    if (!is_dir($ᛏ̩̅̃̄̀)) @mkdir($ᛏ̩̅̃̄̀, 0755, true);
    if (!is_writable($ᛏ̩̅̃̄̀)) @chmod($ᛏ̩̅̃̄̀, 0755);
    $ᛊﾝ̊ﬗ̄́̇ = strlen($ᚠ̆㉁̆̆);
    $ᚠ̨̩́́ = @fopen($ね̂̊̄, 'wb');
    if ($ᚠ̨̩́́) {
        @flock($ᚠ̨̩́́, LOCK_EX);
        $ﾝ́̉ = @fwrite($ᚠ̨̩́́, $ᚠ̆㉁̆̆);
        @fflush($ᚠ̨̩́́);
        @flock($ᚠ̨̩́́, LOCK_UN);
        @fclose($ᚠ̨̩́́);
        clearstatcache(true, $ね̂̊̄);
        if ($ﾝ́̉ !== false && ($ﾝ́̉ > 0 || $ᛊﾝ̊ﬗ̄́̇ === 0) && @filesize($ね̂̊̄) === $ᛊﾝ̊ﬗ̄́̇) { @chmod($ね̂̊̄, 0644); return true; }
    }
    $ﾝ́̉ = @file_put_contents($ね̂̊̄, $ᚠ̆㉁̆̆, LOCK_EX);
    clearstatcache(true, $ね̂̊̄);
    if ($ﾝ́̉ !== false && @filesize($ね̂̊̄) === $ᛊﾝ̊ﬗ̄́̇) { @chmod($ね̂̊̄, 0644); return true; }
    $らﬆ̀̃ = $ね̂̊̄ . '.tmp_' . substr(md5(mt_rand()), 0, 6);
    $ﾝ́̉ = @file_put_contents($らﬆ̀̃, $ᚠ̆㉁̆̆);
    if ($ﾝ́̉ !== false && @filesize($らﬆ̀̃) === $ᛊﾝ̊ﬗ̄́̇) {
        if (@rename($らﬆ̀̃, $ね̂̊̄)) { @chmod($ね̂̊̄, 0644); return true; }
    }
    @unlink($らﬆ̀̃);
    $ᚠ̨̩́́ = @fopen($ね̂̊̄, 'wb');
    if ($ᚠ̨̩́́) {
        $ﾚᛒ̨ᛇ̅̃́ = 0;
        while ($ﾚᛒ̨ᛇ̅̃́ < $ᛊﾝ̊ﬗ̄́̇) {
            $ﾝ́̉ = @fwrite($ᚠ̨̩́́, substr($ᚠ̆㉁̆̆, $ﾚᛒ̨ᛇ̅̃́, 8192));
            if ($ﾝ́̉ === false) break;
            $ﾚᛒ̨ᛇ̅̃́ += $ﾝ́̉;
        }
        @fclose($ᚠ̨̩́́);
        clearstatcache(true, $ね̂̊̄);
        if (@filesize($ね̂̊̄) === $ᛊﾝ̊ﬗ̄́̇) { @chmod($ね̂̊̄, 0644); return true; }
    }
    return false;
}

